# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL (Supabase).
# Example format:
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

DATABASE_URL="YOUR_SUPABASE_URI_HERE"
